# ---------- Mode ----------
# live      = real Solana mainnet through Solami (use this for the bounty demo)
# simulate  = synthetic offline data for UI work only (shows a SIMULATED banner)
MODE=live
PORT=8787

# ---------- Solami (get a key at https://solami.dev, Pro covers everything used here) ----------
SOLAMI_API_KEY=your_solami_api_key
# Header used to send the key on HTTP/WebSocket requests. Change it if your Solami docs say otherwise.
# Leave empty ("") if your endpoint URLs already embed the key.
SOLAMI_AUTH_HEADER=x-api-key

# RPC: full endpoint URL from your Solami dashboard (used for health probe + holder concentration)
SOLAMI_RPC_URL=https://rpc.solami.dev/your_endpoint_or_key_path
SOLAMI_RPC_RPS=50

# Yellowstone gRPC (primary firehose). Token defaults to SOLAMI_API_KEY.
SOLAMI_GRPC_ENDPOINT=https://grpc.solami.dev:443
SOLAMI_GRPC_TOKEN=

# Mirage: Yellowstone over WebSocket (optional alternative/fallback to gRPC)
SOLAMI_MIRAGE_WS_URL=
# Optional JSON subscribe message(s) sent on connect, exactly as in your Mirage docs
SOLAMI_MIRAGE_SUBSCRIBE=

# Blur: decoded DEX trades / pools / liquidity / launches
SOLAMI_BLUR_WS_URL=
# JSON subscribe message(s), exactly as in your Blur docs. Example shape only:
# SOLAMI_BLUR_SUBSCRIBE=[{"op":"subscribe","stream":"trades"},{"op":"subscribe","stream":"liquidity"}]
SOLAMI_BLUR_SUBSCRIBE=

SOLAMI_DATA_API_URL=https://api.solami.dev

# Inbound Solami webhooks -> POST https://<your-host>/webhooks/solami (optional shared secret)
SOLAMI_WEBHOOK_SECRET=

# ---------- Alerts (all optional; the dashboard always shows alerts) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---------- Tuning ----------
# Comma-separated mints or symbols to pin with a star in the table. Everything else is still tracked.
WATCHLIST=
ALERT_MIN_LIQUIDITY_CHANGE_PCT=20
ALERT_WINDOW_SECONDS=300
ALERT_MIN_SCORE=60
ALERT_COOLDOWN_SECONDS=600
MIN_VOLUME_USD=2000
MIN_LIQUIDITY_MOVE_USD=2000
MAX_TRACKED_TOKENS=800

# Reserved for a future Beam integration (not used in this release)
BEAM_ENABLED=false
